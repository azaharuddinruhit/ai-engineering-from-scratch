---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { href } from '@/lib/paths';
---

<BaseLayout title="Page not found" description="This page does not exist.">
  <main id="main" class="mx-auto max-w-xl px-4 py-32 text-center">
    <h1 class="text-4xl font-semibold tracking-[-0.02em] text-heading">This page doesn't exist</h1>
    <p class="mt-4 text-lg text-graphite-600 dark:text-graphite-400">The link may be outdated, or the lesson hasn't been published yet.</p>
    <p class="mt-3 text-sm text-muted">
      In model terms: <code class="font-mono text-graphite-700 dark:text-graphite-300">finish_reason: "not_found"</code>
    </p>
    <a
      href={href()}
      class="mt-8 inline-block rounded-md bg-teal-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-teal-700"
    >
      Back to the curriculum
    </a>
  </main>
</BaseLayout>
