---
import DocsLayout from '@/layouts/DocsLayout.astro';
import ProgressMarks from '@/components/layout/ProgressMarks.astro';
import { getCurriculum, type ModuleWithLessons } from '@/lib/curriculum';

export async function getStaticPaths() {
  const curriculum = await getCurriculum();
  return curriculum
    .filter(({ module }) => module.data.status === 'available')
    .map((entry) => ({ params: { module: entry.module.id }, props: { entry } }));
}

interface Props {
  entry: ModuleWithLessons;
}

const { module, lessons } = Astro.props.entry;
---

<DocsLayout title={module.data.title} description={module.data.summary}>
  <div class="mx-auto max-w-3xl">
    <header class="flex gap-5">
      <span
        class="mt-1 grid size-11 shrink-0 place-items-center rounded-full bg-teal-600 text-lg font-semibold text-white dark:bg-teal-500 dark:text-graphite-950"
        aria-hidden="true"
      >
        {module.data.number}
      </span>
      <div>
        <h1 class="text-4xl font-semibold leading-[1.05] tracking-[-0.02em] text-heading text-balance sm:text-5xl">
          <span class="sr-only">Module {module.data.number}: </span>{module.data.title}
        </h1>
        <p class="mt-2 text-xl italic text-graphite-600 dark:text-graphite-400">{module.data.tagline}</p>
      </div>
    </header>
    <p class="mt-6 text-lg leading-relaxed text-graphite-700 dark:text-graphite-300">{module.data.summary}</p>
    <p class="mt-3 text-sm text-muted" data-progress-count={lessons.map((l) => l.id).join(' ')}>
      {lessons.length} lessons
    </p>

    <ol class="mt-10 border-t border-graphite-200 dark:border-graphite-800">
      {
        lessons.map((lesson, index) => (
          <li class="border-b border-graphite-200 dark:border-graphite-800">
            <a href={lesson.href} class="group grid grid-cols-[2rem_1fr] gap-x-4 py-6">
              <span class="pt-0.5 text-2xl leading-none text-teal-600 dark:text-teal-400" aria-hidden="true">
                {index + 1}
              </span>
              <span class="min-w-0">
                <span class="flex flex-wrap items-center gap-2 text-xl font-semibold text-heading group-hover:text-teal-700 dark:group-hover:text-teal-300">
                  {lesson.title}
                  <span
                    hidden
                    data-progress-lesson={lesson.id}
                    class="rounded bg-emerald-100 px-1.5 py-0.5 text-xs font-medium text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300"
                  >
                    Done
                  </span>
                </span>
                <span class="mt-1.5 block text-graphite-700 dark:text-graphite-300">{lesson.description}</span>
                <span class="mt-2 flex flex-wrap gap-x-5 text-sm text-muted">
                  <span>{lesson.minutes} min read</span>
                  <span>Playground: <span class="italic">{lesson.playground}</span></span>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
  <ProgressMarks />
</DocsLayout>
