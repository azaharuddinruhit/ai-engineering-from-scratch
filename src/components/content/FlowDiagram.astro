---
interface Step {
  label: string;
  detail?: string;
  /** Visually emphasise the steps the lesson focuses on. */
  focus?: boolean;
}

interface Props {
  steps: Step[];
  caption: string;
}

const { steps, caption } = Astro.props;
---

<figure class="not-prose my-8">
  <ol class="flex flex-col items-stretch gap-2 sm:flex-row sm:flex-wrap sm:items-center">
    {
      steps.map((step, index) => (
        <li class="flex flex-col items-center gap-2 sm:flex-row">
          {/* The arrow leads into its step, so a wrapped row starts with one instead of a row ending on one. */}
          {index > 0 && (
            <svg
              class="size-4 shrink-0 rotate-90 text-graphite-400 sm:rotate-0 dark:text-graphite-500"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          )}
          <div
            class:list={[
              'w-full rounded-lg border px-3 py-2 text-center sm:w-auto',
              step.focus
                ? 'border-teal-400 bg-teal-50 dark:border-teal-500 dark:bg-teal-950/50'
                : 'border-graphite-200 bg-graphite-50 dark:border-graphite-800 dark:bg-graphite-900',
            ]}
          >
            <p class="text-sm font-semibold text-heading">{step.label}</p>
            {step.detail && (
              <p class:list={['text-xs', step.focus ? 'text-teal-700 dark:text-teal-300' : 'text-muted']}>
                {step.detail}
              </p>
            )}
          </div>
        </li>
      ))
    }
  </ol>
  <figcaption class="mt-3 text-center text-xs text-muted">{caption}</figcaption>
</figure>
