---
interface Props {
  title: string;
  /** What you observe in production. */
  symptom: string;
}

const { title, symptom } = Astro.props;
---

<section class="not-prose my-5 rounded-lg border border-graphite-200 p-5 dark:border-graphite-800">
  <h3 class="flex items-center gap-2 text-base font-semibold text-heading">
    <svg class="size-4 shrink-0 text-rose-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path
        fill-rule="evenodd"
        d="M8.5 2.9a1.7 1.7 0 0 1 3 0l6.3 11.4A1.7 1.7 0 0 1 16.3 17H3.7a1.7 1.7 0 0 1-1.5-2.7ZM10 7a1 1 0 0 0-1 1v3a1 1 0 1 0 2 0V8a1 1 0 0 0-1-1Zm0 8a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"
        clip-rule="evenodd"></path>
    </svg>
    {title}
  </h3>
  <p class="mt-2 text-graphite-600 dark:text-graphite-400"><span class="font-medium text-graphite-800 dark:text-graphite-200">Symptom:</span> {symptom}</p>
  <div
    class="mt-2 space-y-2 leading-relaxed text-graphite-700 dark:text-graphite-300 [&_code]:rounded [&_code]:bg-graphite-100 [&_code]:px-1 [&_code]:font-mono [&_code]:text-[0.85em] dark:[&_code]:bg-graphite-800 [&_strong]:text-heading"
  >
    <slot />
  </div>
</section>
