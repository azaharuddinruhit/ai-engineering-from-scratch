---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const headings = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  headings.length > 0 && (
    <aside class="hidden w-56 shrink-0 xl:block">
      <nav aria-label="On this page" class="sticky top-24 text-sm">
        <h2 class="mb-3 text-[0.8125rem] font-semibold text-heading">On this page</h2>
        <ul class="space-y-2">
          {headings.map((h) => (
            <li class={h.depth === 3 ? 'pl-3' : ''}>
              <a
                href={`#${h.slug}`}
                class="text-graphite-600 hover:text-teal-700 dark:text-graphite-400 dark:hover:text-teal-300"
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
  )
}
