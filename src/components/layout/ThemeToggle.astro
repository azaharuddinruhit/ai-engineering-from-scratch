<button
  type="button"
  data-theme-toggle
  class="grid size-9 place-items-center rounded-md text-graphite-600 hover:bg-graphite-100 hover:text-graphite-900 dark:text-graphite-400 dark:hover:bg-graphite-900 dark:hover:text-white"
  aria-label="Toggle dark mode"
  aria-pressed="false"
>
  <!-- Sun (shown in dark mode) -->
  <svg class="hidden size-[18px] dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <!-- Moon (shown in light mode) -->
  <svg class="size-[18px] dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    button.setAttribute('aria-pressed', String(root.classList.contains('dark')));
    button.addEventListener('click', () => {
      const dark = root.classList.toggle('dark');
      button.setAttribute('aria-pressed', String(dark));
      try {
        localStorage.setItem('aiefs:theme', dark ? 'dark' : 'light');
      } catch {
        // Storage unavailable: the choice applies to this page view only.
      }
    });
  }
</script>
